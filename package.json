{
  "name": "dji-flight-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Real World Cinematic Flight Planner — monorepo",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dfs/web dev",
    "build": "pnpm --filter @dfs/web build",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm --filter @dfs/web lint",
    "test:rls": "node backend/supabase/tests/rls.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.2.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
